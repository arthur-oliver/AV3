{
  "name": "greencode-av3",
  "version": "3.0.0",
  "description": "Greencode AV3 - API REST com camada analítica, API pública para parceiros e processamento assíncrono",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run build:web && tsc",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "superusuario:redefinir": "tsx prisma/redefinir-superusuario.ts",
    "chave:demo": "tsx prisma/criar-chave-demo.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "setup": "prisma migrate dev --name inicial && prisma db seed",
    "build:web": "vite build --config frontend/vite.config.js",
    "dev:web": "vite --config frontend/vite.config.js",
    "dev:tudo": "node scripts/dev-tudo.js",
    "predev": "node -e \"require('fs').existsSync('web/index.html')||process.exit(1)\" || npm run build:web"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.0.2",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.0",
    "node-cron": "^3.0.3",
    "simple-statistics": "^7.8.7"
  },
  "devDependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@vitejs/plugin-react": "^5.0.0",
    "prisma": "^6.19.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vite": "^7.0.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
