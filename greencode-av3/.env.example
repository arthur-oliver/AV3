# Copie este arquivo para ".env" e ajuste os valores.
#   Windows (cmd):  copy .env.example .env
#   Linux/Ubuntu:   cp .env.example .env

# Conexão MySQL: mysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="mysql://root:SUA_SENHA@localhost:3306/greencode"

# Banco dos testes automatizados (opcional). Se ficar comentado, "npm test" usa o mesmo servidor com o nome
# do banco + "_teste" (ex.: greencode_teste), criado e recriado automaticamente a cada execução.
# DATABASE_URL_TEST="mysql://root:SUA_SENHA@localhost:3306/greencode_teste"

# Servidor HTTP
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Autenticação JWT (JWT_SECRET precisa ter 32 ou mais caracteres)
JWT_SECRET="troque-por-uma-frase-longa-e-aleatoria-com-32-ou-mais-caracteres"
JWT_EXPIRES_IN=1h

# Proteção da API (opcionais)
# Limite geral de requisições por IP, por minuto
RATE_LIMIT_MAX=300
# Origens liberadas no CORS, separadas por vírgula (vazio = nenhuma origem externa)
CORS_ORIGIN=

# --- AV3 ---
# Análises agendadas (node-cron). Padrão: todo dia às 03:00. ANALISES_AGENDADAS=false desliga.
ANALISES_AGENDADAS=true
CRON_ANALISES=0 3 * * *
TZ_AGENDADOR=America/Sao_Paulo

# Fila de relatórios: intervalo do worker, tentativas, espera inicial do retry (dobra a cada falha) e
# tempo máximo de uma tarefa "PROCESSANDO" antes de ser devolvida à fila
WORKER_INTERVALO_MS=2000
TAREFA_MAX_TENTATIVAS=3
TAREFA_BACKOFF_BASE_MS=5000
TAREFA_TRAVADA_APOS_MS=300000

# Limite padrão (requisições por minuto) de uma chave de API nova
LIMITE_CHAVE_PADRAO=60
